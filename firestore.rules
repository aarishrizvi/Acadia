rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "arishrizvi_b-1636@kmclu.ac.in" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (
        isAdmin() ||
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isAdmin();
    }

    // Academies collection
    match /academies/{academyId} {
      allow read: if true; // Publicly browsable
      allow create: if isSignedIn() && (request.resource.data.instructorId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.instructorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.instructorId == request.auth.uid || isAdmin());
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true; // Publicly browsable
      allow create: if isSignedIn() && (request.resource.data.instructorId == request.auth.uid || isAdmin());
      allow update: if isSignedIn(); // Allow updating enrollment count/rating by clients, or course content by instructor/admin
      allow delete: if isSignedIn() && (resource.data.instructorId == request.auth.uid || isAdmin());
    }

    // Lessons collection
    match /lessons/{lessonId} {
      allow read: if true; // Course lessons list/details
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Enrollments collection
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
